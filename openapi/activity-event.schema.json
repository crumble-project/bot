{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "reply"
        },
        "eventId": {
          "type": "string"
        },
        "serverId": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "agentName": {
          "type": "string"
        },
        "entryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "type": "string"
        },
        "preview": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "executionId": {
          "type": "string"
        },
        "jobName": {
          "type": "string"
        },
        "groupId": {
          "type": "string"
        },
        "groupName": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "eventId",
        "serverId",
        "agentId",
        "agentName",
        "entryId",
        "origin",
        "preview",
        "createdAt"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chat-preview"
        },
        "agentId": {
          "type": "string"
        },
        "agentName": {
          "type": "string"
        },
        "lastMessage": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "agentId",
        "agentName",
        "lastMessage"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "learned"
        },
        "agentId": {
          "type": "string"
        },
        "agentName": {
          "type": "string"
        },
        "executionId": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "changeId": {
                "type": "string"
              },
              "target": {
                "type": "string",
                "enum": [
                  "skill",
                  "memory"
                ]
              },
              "action": {
                "type": "string",
                "enum": [
                  "create",
                  "update",
                  "delete",
                  "revert"
                ]
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "changeId",
              "target",
              "action",
              "name"
            ],
            "additionalProperties": true
          }
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "agentId",
        "agentName",
        "executionId",
        "changes",
        "createdAt"
      ],
      "additionalProperties": true
    }
  ]
}
