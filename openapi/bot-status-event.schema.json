{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agentId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "thinking",
        "working",
        "failed",
        "question",
        "blocked"
      ]
    }
  },
  "required": [
    "agentId",
    "status"
  ],
  "additionalProperties": true
}
