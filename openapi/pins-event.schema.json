{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pinnedConversations": {
      "maxItems": 9,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^agent:\\S+$"
      }
    }
  },
  "required": [
    "pinnedConversations"
  ],
  "additionalProperties": true
}
