{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "learned"
    },
    "agentId": {
      "type": "string"
    },
    "agentName": {
      "type": "string"
    },
    "executionId": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "changeId": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "enum": [
              "skill",
              "memory"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete",
              "revert"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "changeId",
          "target",
          "action",
          "name"
        ],
        "additionalProperties": true
      }
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "agentId",
    "agentName",
    "executionId",
    "changes",
    "createdAt"
  ],
  "additionalProperties": true
}
