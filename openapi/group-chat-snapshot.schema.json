{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "entryId": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "blocks": {},
          "stopReason": {
            "type": "string"
          },
          "timestamp": {
            "type": "number"
          },
          "kind": {
            "type": "string"
          },
          "replyTo": {
            "type": "string"
          },
          "replyPreview": {
            "type": "string"
          },
          "origin": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "agentId": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": true
          },
          "communication": {
            "type": "object",
            "properties": {
              "executionId": {
                "type": "string"
              },
              "fromAgentId": {
                "type": "string"
              },
              "fromName": {
                "type": "string"
              },
              "toAgentId": {
                "type": "string"
              },
              "toName": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "sent",
                  "done",
                  "failed",
                  "cancelled"
                ]
              }
            },
            "required": [
              "executionId",
              "fromAgentId",
              "fromName",
              "toAgentId",
              "toName",
              "status"
            ],
            "additionalProperties": true
          },
          "heldAction": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "job": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "job"
            ],
            "additionalProperties": true
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "image",
                    "text"
                  ]
                }
              },
              "required": [
                "name",
                "mimeType",
                "size",
                "kind"
              ],
              "additionalProperties": true
            }
          },
          "toolCallId": {
            "type": "string"
          },
          "toolName": {
            "type": "string"
          },
          "isError": {
            "type": "boolean"
          },
          "toolDetails": {},
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "title"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "id",
          "entryId",
          "role",
          "content"
        ],
        "additionalProperties": true
      }
    },
    "hasMore": {
      "type": "boolean"
    },
    "oldestEntryId": {
      "type": [
        "string",
        "null"
      ]
    },
    "groupChat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "memberIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "memberIds",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": true
    },
    "activity": {
      "type": "object",
      "properties": {
        "paused": {
          "type": "boolean"
        },
        "botTurns": {
          "type": "number"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agentId": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "idle",
                  "queued",
                  "running",
                  "disabled"
                ]
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "agentId",
              "status",
              "error"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "paused",
        "botTurns",
        "members"
      ],
      "additionalProperties": true
    },
    "updatedAt": {
      "type": "number"
    }
  },
  "required": [
    "messages",
    "hasMore",
    "oldestEntryId",
    "groupChat",
    "activity",
    "updatedAt"
  ],
  "additionalProperties": true
}
