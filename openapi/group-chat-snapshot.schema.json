{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "entryId": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/TranscriptBlock"
            }
          },
          "stopReason": {
            "type": "string"
          },
          "timestamp": {
            "type": "number"
          },
          "kind": {
            "type": "string"
          },
          "replyTo": {
            "type": "string"
          },
          "replyPreview": {
            "type": "string"
          },
          "replyReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "eventId": {
                  "type": "string",
                  "minLength": 1
                },
                "surface": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "text"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": true
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "tool-card"
                        },
                        "toolCallId": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "toolCallId"
                      ],
                      "additionalProperties": true
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "held-action"
                        },
                        "actionId": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "actionId"
                      ],
                      "additionalProperties": true
                    }
                  ]
                }
              },
              "required": [
                "eventId",
                "surface"
              ],
              "additionalProperties": true
            }
          },
          "origin": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "agentId": {
                "type": "string"
              },
              "via": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": true
          },
          "communication": {
            "type": "object",
            "properties": {
              "executionId": {
                "type": "string"
              },
              "fromAgentId": {
                "type": "string"
              },
              "fromName": {
                "type": "string"
              },
              "toAgentId": {
                "type": "string"
              },
              "toName": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "sent",
                  "done",
                  "failed",
                  "cancelled"
                ]
              }
            },
            "required": [
              "executionId",
              "fromAgentId",
              "fromName",
              "toAgentId",
              "toName",
              "status"
            ],
            "additionalProperties": true
          },
          "jobQuestion": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "job": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "multiple": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "job"
            ],
            "additionalProperties": true
          },
          "heldAction": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "job": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "job"
            ],
            "additionalProperties": true
          },
          "call": {
            "type": "object",
            "properties": {
              "callId": {
                "type": "string"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "inbound",
                  "outbound"
                ]
              },
              "callee": {
                "type": "string"
              }
            },
            "required": [
              "callId",
              "direction"
            ],
            "additionalProperties": true
          },
          "files": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "mimeType": {
                      "type": "string"
                    },
                    "size": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "mimeType",
                    "size"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "deleted": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "id",
                    "deleted"
                  ],
                  "additionalProperties": true
                }
              ]
            }
          },
          "toolCallId": {
            "type": "string"
          },
          "toolName": {
            "type": "string"
          },
          "isError": {
            "type": "boolean"
          },
          "toolDetails": {},
          "presentation": {
            "$ref": "#/$defs/MessagePresentation"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "title"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "id",
          "entryId",
          "role",
          "content",
          "replyReferences"
        ],
        "additionalProperties": true
      }
    },
    "hasMore": {
      "type": "boolean"
    },
    "oldestEntryId": {
      "type": [
        "string",
        "null"
      ]
    },
    "groupChat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "memberIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "memberIds",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": true
    },
    "activity": {
      "type": "object",
      "properties": {
        "paused": {
          "type": "boolean"
        },
        "botTurns": {
          "type": "number"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agentId": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "idle",
                  "queued",
                  "running",
                  "disabled"
                ]
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "agentId",
              "status",
              "error"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "paused",
        "botTurns",
        "members"
      ],
      "additionalProperties": true
    },
    "updatedAt": {
      "type": "number"
    }
  },
  "required": [
    "messages",
    "hasMore",
    "oldestEntryId",
    "groupChat",
    "activity",
    "updatedAt"
  ],
  "additionalProperties": true,
  "$defs": {
    "TranscriptBlock": {
      "oneOf": [
        {
          "$ref": "#/$defs/TranscriptTextBlock"
        },
        {
          "$ref": "#/$defs/TranscriptThinkingBlock"
        },
        {
          "$ref": "#/$defs/TranscriptImageBlock"
        },
        {
          "$ref": "#/$defs/TranscriptToolCallBlock"
        }
      ]
    },
    "TranscriptTextBlock": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": true
    },
    "TranscriptThinkingBlock": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "thinking"
        },
        "thinking": {
          "type": "string"
        },
        "redacted": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "thinking"
      ],
      "additionalProperties": true
    },
    "TranscriptImageBlock": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "image"
        },
        "mimeType": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "mimeType"
      ],
      "additionalProperties": true
    },
    "TranscriptToolCallBlock": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "toolCall"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "arguments"
      ],
      "additionalProperties": true
    },
    "MessagePresentation": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          }
        }
      },
      "required": [
        "text",
        "citations"
      ],
      "additionalProperties": true
    },
    "Citation": {
      "type": "object",
      "properties": {
        "href": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "site": {
          "type": "string"
        }
      },
      "required": [
        "href",
        "title",
        "site"
      ],
      "additionalProperties": true
    }
  }
}
