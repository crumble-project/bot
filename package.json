{
  "name": "@crumble/server",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "latest",
    "@types/d3-scale": "4.0.9",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@hono/zod-openapi": "1.6.3",
    "@tanstack/charts": "1.1.0",
    "cron-parser": "5.10.2",
    "d3-scale": "4.0.2",
    "hono": "4.13.13",
    "proper-lockfile": "4.1.2",
    "svgpath": "2.6.0",
    "zod": "4.6.7"
  },
  "version": "0.1.0",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "openapi:generate": "bun src/openapi.ts",
    "openapi:check": "bun src/openapi.ts --check",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run openapi:check && bun test"
  }
}
