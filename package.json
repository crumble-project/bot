{
  "name": "crumble",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "fallow": "3.38.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "bun --watch apps/server/src/app/server.ts --dev-workspaces",
    "start": "bun apps/server/src/app/server.ts",
    "test": "bun test --parallel",
    "typecheck": "bun check -p apps/server && bun check -p apps/web",
    "lint": "oxlint --deny-warnings",
    "format": "bun fmt apps",
    "format:check": "bun fmt --check apps",
    "fix": "bun fmt apps && oxlint --fix",
    "openapi:generate": "bun apps/server/src/contract/openapi.ts",
    "openapi:check": "bun apps/server/src/contract/openapi.ts --check",
    "contract:validate": "bun apps/server/src/contract/contract-check.ts validate",
    "contract:compatibility": "bun apps/server/src/contract/contract-check.ts compatibility",
    "agents:check": "bun tools/agents-paths.ts",
    "check": "bun run agents:check && bun run lint && bun run format:check && bun run typecheck && bun run openapi:check && bun run test"
  }
}
