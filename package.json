{
  "name": "crumble",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "fallow": "^3.36.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "bun --watch apps/server/src/app/server.ts",
    "start": "bun apps/server/src/app/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p apps/server && tsc --noEmit -p apps/web",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt apps",
    "format:check": "oxfmt --check apps",
    "fix": "oxfmt apps && oxlint --fix",
    "openapi:generate": "bun apps/server/src/contract/openapi.ts",
    "openapi:check": "bun apps/server/src/contract/openapi.ts --check",
    "contract:bundle": "bun apps/server/src/contract/openapi.ts --bundle",
    "contract:validate": "bun apps/server/src/contract/contract-release.ts validate",
    "contract:compatibility": "bun apps/server/src/contract/contract-release.ts compatibility",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run openapi:check && bun test"
  }
}
