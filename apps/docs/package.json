{
  "name": "@crumble/docs",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun blume dev",
    "check": "bun --bun blume doctor && bun --bun blume validate --strict",
    "build": "bun --bun blume build",
    "preview": "bun --bun blume preview",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "bun run check && bun run build && wrangler deploy"
  },
  "dependencies": {
    "blume": "2.2.4"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
