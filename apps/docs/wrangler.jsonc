{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crumble-docs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "docs.crumbli.ng",
      "custom_domain": true,
    },
  ],
}
