{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Run by drizzle-kit, spawned by tests by path, run as `bun tools/...`, or loaded by Blume, Panda, or TanStack Start by file name.
  "entry": [
    "apps/server/drizzle.*.config.ts",
    "apps/server/test/fixtures/*.ts",
    "apps/server/tools/*.ts",
    "apps/docs/blume.config.ts",
    "apps/docs/theme.css",
    "apps/docs/content/**/*.{ts,mdx}",
    "apps/site/panda.config.ts"
  ],
  "workspaces": {
    "patterns": ["apps/docs", "apps/site"]
  },
  // Vendored oxlint plugins; tools/oxlint/anti-slop/UPSTREAM.md tracks them by checksum, so they stay as upstream wrote them.
  // The workspace image's files reach guests through its Dockerfile and the Railway upload, not through imports.
  // The shadcn stylesheet is copied from npm; its clone groups have no SARIF location, which Code Scanning rejects.
  "ignorePatterns": [
    "tools/oxlint/**",
    "apps/server/workspace-image/**",
    "apps/web/shadcn-tailwind.css"
  ],
  // Imported only by the ignored oxlint plugins.
  "ignoreDependencies": ["@oxlint/plugins"],
  // Generated by `panda codegen` on apps/site's install, so it is absent in a root-only checkout.
  "ignoreUnresolvedImports": ["styled-system/*"],
  // Same route wiring for two features: Hono types each handler by its route, so sharing more loses those types.
  // A clone group has no SARIF location, which Code Scanning rejects, so a kept clone must be ignored here.
  "duplicates": {
    "ignore": [
      "apps/server/src/credentials/credentials-api.ts",
      "apps/server/src/logins/logins-api.ts"
    ]
  },
  "ignoreFindings": ["apps/web/components/ui/**"],
  "ignoreExportsUsedInFile": true,
  "rules": { "boundary-violation": "error" },
  "boundaries": {
    // A file joins the first zone it matches; tests boot the whole app, so they match first and stay unrestricted.
    "zones": [
      { "name": "tests", "patterns": ["apps/**/*.test.ts", "apps/**/*.test.tsx"] },
      { "name": "app", "patterns": ["apps/server/src/app/**"] },
      { "name": "shared", "patterns": ["apps/server/src/shared/**"] },
      { "name": "contract", "patterns": ["apps/server/src/contract/**"] },
      { "name": "workspaces", "patterns": ["apps/server/src/workspaces/**"] },
      // Below features: the store and the ports let features reach bots without importing the runtime above them.
      { "name": "bot-store", "patterns": ["apps/server/src/bot-store/**"] },
      { "name": "bot-ports", "patterns": ["apps/server/src/bot-ports/**"] },
      { "name": "learned-changes", "patterns": ["apps/server/src/learned-changes/**"] },
      { "name": "features", "patterns": ["apps/server/src/**"] },
      // Web, leaf first: a feature's api.ts is importable by every feature, the chat kernel by features, and the bot chat assembles features.
      { "name": "web-base", "patterns": ["apps/web/lib/**", "apps/web/components/**", "apps/web/hooks/**"] },
      { "name": "web-api", "patterns": ["apps/web/features/*/api.ts"] },
      { "name": "web-chat", "patterns": ["apps/web/features/chat/**"] },
      { "name": "web-bot-chat", "patterns": ["apps/web/features/bot-chat/**"] },
      { "name": "web-features", "patterns": ["apps/web/features/**"] },
      { "name": "web", "patterns": ["apps/web/**"] }
    ],
    "rules": [
      { "from": "shared", "allow": [] },
      { "from": "contract", "allow": ["shared"] },
      { "from": "workspaces", "allow": ["shared"] },
      { "from": "bot-store", "allow": ["shared", "contract"] },
      { "from": "bot-ports", "allow": ["shared", "contract"] },
      { "from": "learned-changes", "allow": ["shared", "contract", "bot-store"] },
      { "from": "features", "allow": ["shared", "contract", "workspaces", "bot-store", "bot-ports", "learned-changes"] },
      { "from": "web-base", "allow": ["contract"] },
      { "from": "web-api", "allow": ["web-base", "contract"] },
      { "from": "web-chat", "allow": ["web-api", "web-base", "contract"] },
      { "from": "web-features", "allow": ["web-chat", "web-api", "web-base", "contract"] },
      { "from": "web-bot-chat", "allow": ["web-features", "web-chat", "web-api", "web-base", "contract"] },
      { "from": "web", "allow": ["web-bot-chat", "web-features", "web-chat", "web-api", "web-base", "contract"] }
    ]
  },
  "health": {
    "thresholdOverrides": [
      {
        "files": ["apps/**/*.test.ts", "apps/**/*.test.tsx"],
        "maxUnitSize": 1000,
        "reason": "A describe() callback counts every test inside it; complexity and CRAP limits still apply to tests."
      }
    ]
  },
  "overrides": [
    {
      // The server serves the web UI's bundle, and the web UI imports only the server's API types; nothing builds packages in dependency order.
      "files": ["apps/server/src/app/web-ui.ts", "apps/web/lib/api.ts"],
      "rules": { "package-cycle": "off" }
    }
  ]
}
