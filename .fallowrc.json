{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Run by drizzle-kit, spawned by tests by path, or run as `bun tools/...`.
  "entry": [
    "apps/server/drizzle.*.config.ts",
    "apps/server/test/fixtures/*.ts",
    "apps/server/tools/*.ts"
  ],
  "ignoreFindings": [
    "tools/oxlint/anti-slop/**",
    "apps/web/components/ui/**"
  ],
  "ignoreExportsUsedInFile": true,
  "overrides": [
    {
      // The server serves the web UI's bundle, and the web UI imports only the server's API types; nothing builds packages in dependency order.
      "files": ["apps/server/src/app/web-ui.ts", "apps/web/api.ts"],
      "rules": { "package-cycle": "off" }
    }
  ],
  "duplicates": {
    // Vendored; tools/oxlint/anti-slop/UPSTREAM.md tracks it by checksum, so it stays as upstream wrote it.
    "ignore": ["tools/oxlint/anti-slop/**"]
  }
}
