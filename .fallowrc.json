{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Run by drizzle-kit, spawned by tests by path, run as `bun tools/...`, or loaded by Blume, Panda, or TanStack Start by file name.
  "entry": [
    "tools/check-web-ui.ts",
    "apps/server/drizzle.*.config.ts",
    "apps/server/test/fixtures/*.ts",
    "apps/server/tools/*.ts",
    "apps/docs/blume.config.ts",
    "apps/docs/theme.css",
    "apps/docs/content/**/*.{ts,mdx}",
    "apps/site/panda.config.ts"
  ],
  "workspaces": {
    "patterns": ["apps/docs", "apps/site"]
  },
  // Vendored oxlint plugins; tools/oxlint/anti-slop/UPSTREAM.md tracks them by checksum, so they stay as upstream wrote them.
  "ignorePatterns": ["tools/oxlint/**"],
  // Imported only by the ignored oxlint plugins.
  "ignoreDependencies": ["@oxlint/plugins"],
  // Generated by `panda codegen` on apps/site's install, so it is absent in a root-only checkout.
  "ignoreUnresolvedImports": ["styled-system/*"],
  "ignoreFindings": ["apps/web/components/ui/**"],
  "ignoreExportsUsedInFile": true,
  "rules": { "boundary-violation": "error" },
  "boundaries": {
    // A file joins the first zone it matches; tests boot the whole app, so they match first and stay unrestricted.
    "zones": [
      { "name": "tests", "patterns": ["apps/**/*.test.ts", "apps/**/*.test.tsx"] },
      { "name": "app", "patterns": ["apps/server/src/app/**"] },
      { "name": "shared", "patterns": ["apps/server/src/shared/**"] },
      { "name": "contract", "patterns": ["apps/server/src/contract/**"] },
      { "name": "features", "patterns": ["apps/server/src/**"] },
      { "name": "web", "patterns": ["apps/web/**"] }
    ],
    "rules": [
      { "from": "shared", "allow": [] },
      { "from": "features", "allow": ["shared", "contract"] },
      { "from": "web", "allow": ["contract"] }
    ]
  },
  "health": {
    "thresholdOverrides": [
      {
        "files": ["apps/**/*.test.ts", "apps/**/*.test.tsx"],
        "maxUnitSize": 1000,
        "reason": "A describe() callback counts every test inside it; complexity and CRAP limits still apply to tests."
      }
    ]
  },
  "overrides": [
    {
      // The server serves the web UI's bundle, and the web UI imports only the server's API types; nothing builds packages in dependency order.
      "files": ["apps/server/src/app/web-ui.ts", "apps/web/lib/api.ts"],
      "rules": { "package-cycle": "off" }
    }
  ]
}
